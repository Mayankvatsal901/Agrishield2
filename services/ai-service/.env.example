HOST=0.0.0.0
PORT=8000
UPLOAD_DIR=uploads
OCR_LANG=en
OCR_USE_GPU=false
ELA_THRESHOLD=12.0
NOISE_STD_THRESHOLD=18.0
COPY_MOVE_MIN_MATCHES=30
BLUR_THRESHOLD=80.0
# macOS Homebrew arm64 — install zbar first: brew install zbar
ZBAR_LIBRARY=/opt/homebrew/lib/libzbar.0.dylib
DYLD_LIBRARY_PATH=/opt/homebrew/lib
