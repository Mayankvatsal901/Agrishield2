# Each backend service runs on its own port (the API gateway does not proxy yet).
# Copy this file to .env and adjust if your services use different ports.
VITE_AUTH_URL=http://localhost:5001
VITE_USER_URL=http://localhost:5002
VITE_MARKETPLACE_URL=http://localhost:5003
VITE_DEAL_URL=http://localhost:5004
VITE_CHAT_URL=http://localhost:6000
VITE_BLOCKCHAIN_URL=http://localhost:5007

# socket-service and ml-service both default to 5008.
# Run socket-service with PORT=5009 (or change this to match).
VITE_SOCKET_URL=http://localhost:5009
